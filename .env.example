# AsistLine AI Environment Variables

# App Environment
ENV=development
LOG_LEVEL=INFO

# Backend API
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=dev-secret-key-change-in-production-32bytes

# Database (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql+asyncpg://asistline:asistline_secret@localhost:5432/asistline_db
DATABASE_URL_SYNC=postgresql+psycopg2://asistline:asistline_secret@localhost:5432/asistline_db

# LiveKit WebRTC
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# AI Models (Gemini & ElevenLabs)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_ID=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_STT_MODEL=scribe_v1
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# Default Thresholds & Constants
DEFAULT_KB_MIN_SCORE=0.55
DEFAULT_QUEUE_TIMEOUT_SECONDS=45
DEFAULT_SILENCE_TIMEOUT_SECONDS=6.0

# Mock Backends URL
MOCK_BACKENDS_URL=http://localhost:9000
